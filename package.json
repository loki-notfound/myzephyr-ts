{
  "name": "@loki-notfound/zephyr-ts",
  "description": "TypeScript wallet library for Zephyr: a port of monero-ts onto the signed zephyr-backports core",
  "version": "2.3.0-sec.2-ts.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loki-notfound/myzephyr-ts.git"
  },
  "homepage": "https://github.com/loki-notfound/myzephyr-ts#readme",
  "bugs": {
    "url": "https://github.com/loki-notfound/myzephyr-ts/issues"
  },
  "main": "./dist/src/main/ts/index.js",
  "types": "./dist/src/main/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/main/ts/index.d.ts",
      "browser": "./dist/zephyr-ts.browser.mjs",
      "default": "./dist/src/main/ts/index.js"
    },
    "./zephyr.wasm": "./dist/zephyr.wasm",
    "./zephyr.worker.js": "./dist/zephyr.worker.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#zephyr-sdk/zephyr.js": "./dist/zephyr.js",
    "#zephyr-sdk/zephyr.digest.js": "./dist/zephyr.digest.js"
  },
  "browser": {
    "socks-proxy-agent": false
  },
  "files": [
    "dist/zephyr.js",
    "dist/zephyr.wasm",
    "dist/zephyr.digest.js",
    "dist/zephyr.worker.js",
    "dist/zephyr.worker.js.LICENSE.txt",
    "dist/zephyr-ts.browser.mjs",
    "dist/src/main/",
    "docs/LIMITATIONS.md",
    "docs/DEPLOYMENT.md",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "bin/build.sh",
    "test:offline": "bin/test_offline.sh",
    "test:network": "bin/test_network.sh",
    "pack:check": "bin/pack.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.2",
    "@types/node": "^20.6.0",
    "async": "2.6.4",
    "axios": "^1.7.4",
    "crypto-js": "^4.0.0",
    "decimal.js": "^10.4.3",
    "socks-proxy-agent": "^8.0.5",
    "web-worker": "1.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.10",
    "@babel/core": "^7.22.17",
    "@babel/node": "^7.18.10",
    "@babel/plugin-transform-runtime": "^7.18.10",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-typescript": "^7.22.15",
    "@babel/register": "^7.22.15",
    "@types/jquery": "^3.5.19",
    "@types/mocha": "^9.1.1",
    "@typescript-eslint/eslint-plugin": "5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "assert": "^2.1.0",
    "babel-loader": "^9.1.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "https-browserify": "^1.0.0",
    "memfs": "^4.11.1",
    "mocha": "^9.1.3",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "shx": "^0.3.4",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.1",
    "typescript": "^5.2.2",
    "url": "^0.11.3",
    "util": "^0.12.5",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  }
}
